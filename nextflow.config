manifest {
    name            = 'blaCTX_pipeline'
    description     = 'K. pneumoniae assembly QC and blaCTX-M-15 AMR screening'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.6'
    license         = 'MIT'
}

params {
    // Inputs / outputs
    samples          = 'config/samples.tsv'
    results          = 'results'
    threads          = 10
    // Storage-efficient mode: delete raw/trimmed reads and assembler scratch dirs from work/ once consumed.
    // Side effect: -resume cannot reuse FETCH_SRA/FASTP results after they ran (they are re-run).
    delete_intermediates = true
    target_gene      = 'blaCTX-M-15'

    // Reference databases (see README, "Reference databases")
    card_json        = "${projectDir}/resources/card_data/card.json"
    resfinder_db     = "${projectDir}/resources/resfinder/db_resfinder"
    busco_db         = "${projectDir}/resources/busco_db/enterobacterales_odb10"

    // Tool settings
    // Expected genome size passed to Shovill (skips its k-mer based estimate)
    genome_size      = '5.5M'

    // SPAdes memory limit in GB (single-end assembly)
    spades_memory    = 8

    rgi_aligner      = 'BLAST'
    resfinder_species = 'Klebsiella'

    // fastp read QC / trimming
    fastp_min_quality = 20
    fastp_window_size = 4
    fastp_min_length  = 50

    // Phylogenomics (results/07_phylogenomics/)
    bakta_db         = "${projectDir}/resources/db-light"
    panaroo_mode     = 'strict'          // strict | moderate | sensitive
    panaroo_core_threshold = 0.98
    gubbins_tree_builder = 'fasttree'    // fasttree | raxml | iqtree | ...
    gubbins_iterations   = 5
    iqtree_model     = 'MFP+ASC'         // ModelFinder; +ASC is required for SNP-only alignments
    iqtree_bootstraps = 1000
    iqtree_seed      = 42
    // Gubbins/IQ-TREE need >= 4 genomes; skip the phylogeny below this
    min_phylo_samples = 4

    // Container images (used by -profile docker / singularity; conda profiles ignore them).
    // Tool images are pinned bioconda biocontainers. 'helper' (python + pandas + openpyxl + sra-tools)
    // has no biocontainer: build it from containers/helper/Dockerfile and point this at your registry.
    container_helper = 'ghcr.io/hasibulhossainsau-netizen/blactx-helper:0.1.0'

    // BUSCO lineage name (used to label BUSCO summaries for MultiQC)
    busco_lineage    = 'enterobacterales_odb10'

    // Assembly QC thresholds (mirrors config/config.yaml)
    busco_min        = 95
    coverage_min     = 50
    max_contigs      = 200
    min_contig_len   = 500
}

process {
    cpus  = params.threads
    shell = ['/bin/bash', '-euo', 'pipefail']

    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: MULTIQC {
        cpus = 1
    }

    // Container images; only applied under -profile docker / singularity
    withName: 'FETCH_SRA|FILTER_ASSEMBLY|PROMOTE|SUMMARY' {
        container = params.container_helper
    }
    withName: FASTP {
        container = 'quay.io/biocontainers/fastp:1.3.7'
    }
    // shovill's image also provides skesa and spades (SE assemblies use spades.py directly)
    withName: 'ASSEMBLY|COVERAGE' {
        container = 'quay.io/biocontainers/shovill:1.4.2--hdfd78af_1'
    }
    withName: BUSCO {
        container = 'quay.io/biocontainers/busco:5.8.2--pyhdfd78af_0'
    }
    withName: RGI {
        container = 'quay.io/biocontainers/rgi:6.0.8--pyh05cac1d_0'
    }
    withName: RESFINDER {
        container = 'quay.io/biocontainers/resfinder:4.7.2--pyhdfd78af_0'
    }
    withName: MULTIQC {
        container = 'quay.io/biocontainers/multiqc:1.34--pyhdfd78af_0'
    }
    withName: BAKTA {
        container = 'quay.io/biocontainers/bakta:1.12.2--pyhdfd78af_0'
    }
    withName: PANAROO {
        container = 'quay.io/biocontainers/panaroo:1.8.0--pyhdfd78af_1'
    }
    withName: GUBBINS {
        container = 'quay.io/biocontainers/gubbins:3.4.3--py310hfc0ef84_1'
    }
    withName: IQTREE {
        container = 'quay.io/biocontainers/iqtree:2.4.0--h503566f_0'
    }

    withName: FETCH_SRA {
        // network-bound; retry more patiently, one CPU so more downloads run concurrently
        cpus          = 1
        maxRetries    = 3
    }
}

profiles {
    // Default way to run: per-process conda envs from workflow/envs/
    conda {
        conda.enabled   = true
        conda.useMamba  = false
        conda.cacheDir  = "${projectDir}/.conda_cache"
    }

    // Same as conda, but resolve environments with mamba
    mamba {
        conda.enabled   = true
        conda.useMamba  = true
        conda.cacheDir  = "${projectDir}/.conda_cache"
    }

    // Same as conda, but resolve environments with micromamba
    micromamba {
        conda.enabled        = true
        conda.useMicromamba  = true
        conda.cacheDir       = "${projectDir}/.conda_cache"
    }

    // Docker containers. projectDir is mounted read-only because processes call
    // ${projectDir}/workflow/scripts/*.py and read ${projectDir}/resources/* databases.
    // If you override --card_json/--resfinder_db/--busco_db/--bakta_db with paths outside
    // projectDir, add a matching -v to docker.runOptions.
    docker {
        docker.enabled    = true
        // Nextflow already mounts the launch directory, so only add projectDir when it
        // differs (a second mount of the same path fails: "Duplicate mount point")
        docker.runOptions = "-u \$(id -u):\$(id -g)" + (projectDir.toString() != launchDir.toString() ? " -v ${projectDir}:${projectDir}:ro" : '')
        docker.registry   = ''
    }

    // Singularity / Apptainer containers (HPC); same mount caveat as docker
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "-B ${projectDir}"
        singularity.cacheDir   = "${projectDir}/.singularity_cache"
    }

    // Fast wiring check: no tools or downloads, uses each process's stub block
    // usage: nextflow run main.nf -profile test -stub-run
    test {
        process.executor = 'local'
        params.threads   = 2
        params.results   = 'results_test'
        // CI runners have 4 CPUs; cap every task regardless of per-process settings
        process.cpus           = 2
        process.resourceLimits = [cpus: 4, memory: '12.GB', time: '1.h']
    }

    dryrun {
        process.executor = 'local'
    }
}

timeline { enabled = true; overwrite = true; file = "${params.results}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.results}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.results}/pipeline_info/trace.txt" }
